sh echo "=== 1. h3 tries the restricted port ==="
h3 python3 tcp_client.py --mode restricted --ip 10.0.0.10 --count 4
sh echo "=== 2. block rule on the switch ==="
sh ovs-ofctl -O OpenFlow13 dump-flows s1 | grep priority=1000
sh echo "=== 3. h3 (blocked) tries the allowed port ==="
h3 python3 tcp_client.py --mode normal --ip 10.0.0.10
sh echo "=== 4. h1 (not blocked) tries the allowed port ==="
h1 python3 tcp_client.py --mode normal --ip 10.0.0.10
